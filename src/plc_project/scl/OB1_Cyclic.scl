REGION "=== 运行时间累计（每100ms循环一次） ==="
    "DB30_Status".runtime_hours := "DB30_Status".runtime_hours + 0.1 / 3600.0;
END_REGION

REGION "=== 退化程度计算 ==="
    // 正常运行时退化缓慢，超过500小时后加速
    IF "DB30_Status".runtime_hours < 500.0 THEN
        "DB30_Status".degradation_level := "DB30_Status".runtime_hours / 5000.0;
    ELSE
        "DB30_Status".degradation_level := 0.1 + ("DB30_Status".runtime_hours - 500.0) / 2000.0;
    END_IF;
    
    // 退化上限
    IF "DB30_Status".degradation_level > 1.0 THEN
        "DB30_Status".degradation_level := 1.0;
    END_IF;
END_REGION

REGION "=== 振动模拟 ==="
    // 基线振动 + 退化增量 + 随机噪声
    "DB10_Vibration".vibration_x := 2.0 + "DB30_Status".degradation_level * 8.0 + (SIN("DB30_Status".runtime_hours) * 0.5);
    "DB10_Vibration".vibration_y := 1.8 + "DB30_Status".degradation_level * 7.0 + (SIN("DB30_Status".runtime_hours * 1.3) * 0.4);
    "DB10_Vibration".vibration_z := 1.5 + "DB30_Status".degradation_level * 5.0 + (SIN("DB30_Status".runtime_hours * 0.7) * 0.3);
    "DB10_Vibration".rms_value := SQRT(("DB10_Vibration".vibration_x ** 2 + "DB10_Vibration".vibration_y ** 2 + "DB10_Vibration".vibration_z ** 2) / 3.0);
END_REGION

REGION "=== 温度模拟 ==="
    "DB20_Temperature".bearing_temp := 25.0 + "DB30_Status".degradation_level * 40.0 + (SIN("DB30_Status".runtime_hours * 0.5) * 1.0);
    "DB20_Temperature".motor_temp := 30.0 + "DB30_Status".degradation_level * 25.0 + (SIN("DB30_Status".runtime_hours * 0.3) * 0.8);
    "DB20_Temperature".ambient_temp := 20.0 + (SIN("DB30_Status".runtime_hours * 0.1) * 2.0);
END_REGION