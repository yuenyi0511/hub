<?xml version="1.0" encoding="utf-8"?>
<!-- DB20_Temperature 温度数据 -->
<DB>
  <Name>DB20_Temperature</Name>
  <OptimizedBlockAccess>false</OptimizedBlockAccess>
  <Variables>
